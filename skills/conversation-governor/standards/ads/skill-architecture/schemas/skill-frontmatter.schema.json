{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-devmode.invalid/ads/5.0.0-rc.2/skill-architecture/skill-frontmatter.schema.json",
  "title": "Agent Skill canonical frontmatter",
  "description": "Cross-host canonical SKILL.md frontmatter for ADS 5 release candidates.",
  "x-ads-schema-version": "5.0.0-rc.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description"
  ],
  "properties": {
    "name": {
      "$ref": "https://schemas.ai-devmode.invalid/ads/5.0.0-rc.2/skill-architecture/ads-common-definitions.schema.json#/$defs/skillName"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "skill_uri",
        "skill_version",
        "ads_version",
        "repository",
        "lifecycle",
        "configuration"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "skill_uri": {
          "type": "string",
          "pattern": "^skill:[a-z0-9-]+\\.[a-z0-9-]+$"
        },
        "skill_version": {
          "type": "string",
          "minLength": 1
        },
        "ads_version": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "lifecycle": {
          "enum": [
            "stateless",
            "stateful"
          ]
        },
        "configuration": {
          "enum": [
            "configurable",
            "non-configurable"
          ]
        }
      }
    }
  }
}
