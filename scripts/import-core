#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
META="$ROOT/scripts/project_meta.py"
ARCHIVE="${1:-}"

if [[ -z "$ARCHIVE" || ! -f "$ARCHIVE" ]]; then
  echo "usage: scripts/import-core /path/to/core.zip" >&2
  exit 2
fi

cd "$ROOT"
if [[ -n "$(git status --porcelain)" ]]; then
  echo "working tree must be clean before core import" >&2
  exit 1
fi

EXPECTED_NAME="$($META core.source_archive)"
EXPECTED_SHA="$($META core.sha256)"
VERSION="$($META core.version)"
CORE_TAG="$($META core.tag)"
ACTUAL_SHA="$(sha256sum "$ARCHIVE" | awk '{print $1}')"
if [[ "$ACTUAL_SHA" != "$EXPECTED_SHA" ]]; then
  echo "core archive checksum mismatch" >&2
  echo "expected: $EXPECTED_SHA" >&2
  echo "actual:   $ACTUAL_SHA" >&2
  exit 1
fi

OLD_HEAD="$(git rev-parse HEAD)"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

python3 - "$ARCHIVE" "$TMP/core" "$VERSION" <<'PY'
from pathlib import Path
from zipfile import ZipFile
import re, shutil, sys

archive=Path(sys.argv[1])
out=Path(sys.argv[2])
version=sys.argv[3]
raw=out.parent/'raw'
raw.mkdir(parents=True,exist_ok=True)

with ZipFile(archive) as z:
    for info in z.infolist():
        p=Path(info.filename)
        if p.is_absolute() or '..' in p.parts:
            raise SystemExit(f'unsafe archive path: {info.filename}')
        z.extract(info,raw)

entries=[p for p in raw.iterdir() if p.name not in {'__MACOSX'}]
source=entries[0] if len(entries)==1 and entries[0].is_dir() else raw
out.mkdir(parents=True,exist_ok=True)

# Preserve internal archive filenames. If the archive has one release-versioned
# top-level directory, it is flattened so versioning remains in Git metadata/tags.
for src in sorted(source.rglob('*')):
    rel=src.relative_to(source)
    dst=out/rel
    if src.is_dir():
        dst.mkdir(parents=True,exist_ok=True)
    elif src.is_file():
        dst.parent.mkdir(parents=True,exist_ok=True)
        shutil.copy2(src,dst)
PY

# Remember proposal-tag targets before rewriting the root history.
declare -A TAG_TARGETS
for tag in proposal-0.2 proposal-0.17 proposal-0.25 proposal-0.30 proposal-0.40; do
  TAG_TARGETS[$tag]="$(git rev-list -n 1 "$tag")"
done

COMMITS=( $(git rev-list --reverse "$OLD_HEAD") )

git switch --orphan __core_import_rebuild >/dev/null 2>&1
git rm -rf . >/dev/null 2>&1 || true
find . -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf {} +
mkdir -p core
cp -a "$TMP/core/." core/
git add core
git commit -m "Import AI DevMode Standards $VERSION" \
  -m "Import the supplied core standards archive as the repository foundation.\n\nArchive: $EXPECTED_NAME\nSHA-256: $EXPECTED_SHA\n\nA single release-versioned archive root is flattened when present; internal core filenames and file contents are preserved." >/dev/null
CORE_COMMIT="$(git rev-parse HEAD)"
git tag -f -a "$CORE_TAG" "$CORE_COMMIT" -m "AI DevMode Standards $VERSION" >/dev/null

declare -A NEW_BY_OLD
for old in "${COMMITS[@]}"; do
  git cherry-pick "$old" >/dev/null
  NEW_BY_OLD[$old]="$(git rev-parse HEAD)"
done

for tag in proposal-0.2 proposal-0.17 proposal-0.25 proposal-0.30 proposal-0.40; do
  old="${TAG_TARGETS[$tag]}"
  new="${NEW_BY_OLD[$old]}"
  version="${tag#proposal-}"
  git tag -d "$tag" >/dev/null
  git tag -a "$tag" "$new" -m "AI Aided Hive Engineering Proposal Draft $version"
done

NEW_HEAD="$(git rev-parse HEAD)"
git branch -f main "$NEW_HEAD" >/dev/null
git switch main >/dev/null 2>&1
git branch -D __core_import_rebuild >/dev/null

./scripts/validate

echo "core import complete"
echo "core tag: $CORE_TAG"
echo "main: $(git rev-parse --short HEAD)"
